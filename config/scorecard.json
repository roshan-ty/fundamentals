  "instruments": {
    "method": "Each precious metal and energy instrument scores from: inverse USD calendar score + COT positioning component. Real yields / DXY run as confirmation only (never scored).",
    "targets": {
      "XAUUSD": {"kind": "metal", "usd_inverse": 1.0, "cot_weight": 0.5, "name": "Gold"},
      "XAGUSD": {"kind": "metal", "usd_inverse": 1.0, "cot_weight": 0.5, "name": "Silver"},
      "XPTUSD": {"kind": "metal", "usd_inverse": 1.0, "cot_weight": 0.5, "name": "Platinum"},
      "XPDUSD": {"kind": "metal", "usd_inverse": 1.0, "cot_weight": 0.5, "name": "Palladium"},
      "OIL": {"kind": "energy", "usd_inverse": 0.7, "cot_weight": 0.5, "name": "Crude Oil (WTI)", "extra_points": [{"id": "eia_inventories", "name": "EIA Crude Oil Inventories", "direction": "lower_is_bullish", "weight": 1.0, "target": "OIL"}, {"id": "eia_inventories_cad", "name": "EIA Crude Oil Inventories (CAD)", "direction": "lower_is_bullish", "weight": 0.5, "target": "CAD"}], "note": "Inventory drawdown (Actual < Previous) is bullish for oil and CAD."},
      "BRENT": {"kind": "energy", "usd_inverse": 0.7, "cot_weight": 0.5, "name": "Brent Crude"},
      "COPPER": {"kind": "industrial", "usd_inverse": 0.7, "cot_weight": 0.5, "name": "Copper", "note": "Industrial metal; also driven by Chinese trade/demand data."}
    },
    "opec_jmmc": {"id": "opec_jmmc", "name": "OPEC-JMMC Meetings", "kind": "informational", "note": "Qualitative; feeds the analysis narrative only, no numeric score."}
  },
  "derived": {
    "method": "Crypto and equity index instruments have no country calendar or CFTC COT. Bias = inverse normalized USD score + global risk-appetite proxy (10Y real yield, index breadth, US calendar).",
    "label": "derived",
    "usd_weight": 0.6,
    "risk_weight": 0.4,
    "targets": ["BTCUSD", "ETHUSD", "LTCUSD", "SOLUSD", "SUIUSD", "XLMUSD", "XRPUSD", "AVAXUSD", "US30", "US100", "US500", "GER40", "EU50", "GB100", "FR40", "JP225", "HK50", "AUS200", "CH20", "ES35"]
  }
