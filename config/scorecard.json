{
  "schema": "1.0",
  "description": "Bias scoring scorecard. A data point is scored ONLY when Actual differs from Previous (stronger/weaker per 'direction'). No change = 0. Weights are impact tiers; higher = more impactful. Currency score = 5 + 5 * (netBuffWeight / totalEligibleWeight), clamped 0-10, 5 = neutral.",
  "bands": {
    "0-2": "very bearish",
    "3-4": "bearish",
    "5": "neutral",
    "6-7": "bullish",
    "8-10": "very bullish"
  },
  "direction_meaning": {
    "higher_is_bullish": "Actual > Previous scores positive",
    "lower_is_bullish": "Actual < Previous scores positive",
    "unchanged_is_zero": "Actual == Previous scores 0"
  },
  "currencies": {
    "USD": {
      "name": "United States Dollar",
      "dataPoints": [
        {"id": "us_fed_funds", "name": "Federal Funds Rate / FOMC Statement / FOMC Press Conference", "direction": "higher_is_bullish", "weight": 2.0, "match": ["Federal Funds Rate", "FOMC Statement", "FOMC Press Conference", "Fed Funds", "Fed Interest Rate", "FOMC Rate"]},
        {"id": "us_nfp", "name": "Non-Farm Employment Change (NFP)", "direction": "higher_is_bullish", "weight": 1.5, "match": ["Non-Farm Employment Change", "Nonfarm Payrolls", "Non-Farm Payrolls", "Change in Non-Farm Payrolls"]},
        {"id": "us_unemployment", "name": "Unemployment Rate", "direction": "lower_is_bullish", "weight": 1.0, "match": ["Unemployment Rate"]},
        {"id": "us_ahe", "name": "Average Hourly Earnings (m/m, y/y)", "direction": "higher_is_bullish", "weight": 1.0, "match": ["Average Hourly Earnings"]},
        {"id": "us_cpi", "name": "CPI & Core CPI (m/m, y/y)", "direction": "higher_is_bullish", "weight": 1.5, "match": ["CPI m/m", "CPI y/y", "Core CPI m/m", "Core CPI y/y", "CPI x", "Core CPI x"]},
        {"id": "us_pce", "name": "Core PCE Price Index (m/m, y/y)", "direction": "higher_is_bullish", "weight": 1.5, "match": ["Core PCE", "PCE Price Index", "Core PCE Price"]},
        {"id": "us_gdp", "name": "Advance GDP (q/q)", "direction": "higher_is_bullish", "weight": 1.5, "match": ["GDP q/q", "GDP y/y", "Gross Domestic Product", "Advance GDP"]},
        {"id": "us_ism", "name": "ISM Manufacturing PMI & ISM Services PMI", "direction": "higher_is_bullish", "weight": 1.0, "match": ["ISM Manufacturing PMI", "ISM Services PMI", "ISM Manufacturing", "ISM Services"]},
        {"id": "us_retail", "name": "Retail Sales & Core Retail Sales (m/m)", "direction": "higher_is_bullish", "weight": 1.0, "match": ["Retail Sales"]},
        {"id": "us_adp", "name": "ADP Non-Farm Employment Change", "direction": "higher_is_bullish", "weight": 1.0, "match": ["ADP Non-Farm Employment Change", "ADP Employment Change", "ADP Nonfarm"]},
        {"id": "us_claims", "name": "Unemployment Claims (Weekly)", "direction": "lower_is_bullish", "weight": 0.5, "match": ["Initial Jobless Claims", "Unemployment Claims", "Jobless Claims", "Continuing Jobless Claims"]},
        {"id": "us_ppi", "name": "PPI & Core PPI (m/m)", "direction": "higher_is_bullish", "weight": 1.0, "match": ["PPI m/m", "PPI y/y", "Core PPI m/m", "Core PPI y/y", "Producer Prices"]},
        {"id": "us_confidence", "name": "CB Consumer Confidence / UoM Consumer Sentiment", "direction": "higher_is_bullish", "weight": 0.5, "match": ["CB Consumer Confidence", "Michigan Consumer Sentiment", "UoM Consumer Sentiment", "Consumer Confidence"]},
        {"id": "us_housing", "name": "Building Permits & Housing Starts", "direction": "higher_is_bullish", "weight": 0.5, "match": ["Building Permits", "Housing Starts", "New Home Sales", "Existing Home Sales"]},
        {"id": "us_trade", "name": "Trade Balance", "direction": "higher_is_bullish", "weight": 0.5, "match": ["Trade Balance"]}
      ]
    },
    "EUR": {
