{
  "schema": "1.0",
  "description": "Instrument-specific news filtering. Each entry: [include keywords that must appear, exclude keywords (optional)]. Matches performed case-insensitively against headline + snippet.",
  "rules": {
    "XAUUSD": {"include": ["gold", "gold price", "bullion", "xau"], "exclude": ["etf flows", "silver etf"]},
    "XAGUSD": {"include": ["silver", "xag"], "exclude": []},
    "XPTUSD": {"include": ["platinum"], "exclude": ["credit card"]},
    "XPDUSD": {"include": ["palladium"], "exclude": []},
    "OIL": {"include": ["crude", "oil price", "wti", "opec", "brent"], "exclude": ["olive oil", "palm oil", "cooking oil"]},
    "BRENT": {"include": ["brent", "crude", "opec", "oil price", "oil inventories"], "exclude": ["olive oil", "palm oil", "cooking oil"]},
    "COPPER": {"include": ["copper"], "exclude": []},
    "USD": {"include": ["dollar", "fed", "federal reserve", "fomc", "us economy", "us inflation", "usd", "nonfarm", "treasury yield"], "exclude": ["dollarama"]},
    "EUR": {"include": ["euro", "ecb", "eurozone", "germany", "france", "italy", "spain"], "exclude": ["eurovision"]},
    "GBP": {"include": ["sterling", "british pound", "uk economy", "bank of england", "boe"], "exclude": []},
    "JPY": {"include": ["yen", "japan", "boj", "bank of japan"], "exclude": []},
    "AUD": {"include": ["australian dollar", "rba", "australia economy", "china"], "exclude": ["australian open"]},
    "NZD": {"include": ["new zealand", "kiwi", "rbnz", "nzd"], "exclude": []},
    "CAD": {"include": ["canadian dollar", "loonie", "bank of canada", "boc", "canada"], "exclude": ["canada dry"]},
    "CHF": {"include": ["swiss franc", "snb", "swiss national bank", "switzerland"], "exclude": ["swiss army"]},
    "CNY": {"include": ["yuan", "renminbi", "china", "pboc", "chinese economy"], "exclude": []},
    "BTCUSD": {"include": ["bitcoin", "btc"], "exclude": []},
    "ETHUSD": {"include": ["ethereum", "eth"], "exclude": []},
    "LTCUSD": {"include": ["litecoin"], "exclude": []},
    "SOLUSD": {"include": ["solana"], "exclude": []},
    "SUIUSD": {"include": ["sui blockchain", "sui network", "sui crypto"], "exclude": []},
    "XLMUSD": {"include": ["stellar", "xlm"], "exclude": ["stellaris"]},
    "XRPUSD": {"include": ["xrp", "ripple"], "exclude": []},
    "AVAXUSD": {"include": ["avalanche", "avax"], "exclude": ["avalanche warning"]},
    "US500": {"include": ["s&p 500", "sp500", "wall street", "nasdaq", "us stocks", "stock market", "dow"], "exclude": []},
    "US100": {"include": ["nasdaq", "tech stocks", "us100"], "exclude": []},
    "US30": {"include": ["dow jones", "dow", "us30"], "exclude": ["dow chemical"]},
    "GE40": {"include": ["dax", "german stocks", "frankfurt"], "exclude": []},
    "EU50": {"include": ["stoxx", "euro zone stocks", "european stocks"], "exclude": []},
    "GB100": {"include": ["ftse", "london stocks", "uk stocks"], "exclude": []},
    "FR40": {"include": ["cac 40", "french stocks", "paris stocks"], "exclude": []},
    "JP225": {"include": ["nikkei", "japanese stocks", "tokyo stocks"], "exclude": []},
    "HK50": {"include": ["hang seng", "hong kong stocks"], "exclude": []},
    "AUS200": {"include": ["asx", "australian stocks"], "exclude": []},
    "CH20": {"include": ["swiss stocks", "smi", "zurich stocks"], "exclude": ["smi smile"]},
    "ES35": {"include": ["ibex", "spanish stocks", "madrid stocks"], "exclude": []},
    "GLOBAL": {"include": ["global", "world economy", "imf", "world bank", "geopolitical"], "exclude": []}
  }
}